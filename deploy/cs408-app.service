[Unit]
Description=CS 408 final project (Node.js app)
After=network.target

[Service]
Type=simple
# setup-ec2.sh replaces this with the user who ran it (ubuntu by default)
User=ubuntu
WorkingDirectory=/opt/cs408-app
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=127.0.0.1
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
