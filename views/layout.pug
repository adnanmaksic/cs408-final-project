doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= title ? `${title} | ${appName}` : `${appName} | Assignments and grades in one place`
    link(rel="icon" href="/favicon.svg" type="image/svg+xml")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css")
    link(rel="stylesheet" href="/css/custom.css")
  body.d-flex.flex-column.min-vh-100
    a.visually-hidden-focusable.position-absolute.p-2.bg-white(href="#main") Skip to content

    //- Centered brand; clicking it slides open a row of links underneath.
    nav.navbar.navbar-dark.app-navbar
      .container.flex-column
        button.brand-toggle(type="button" data-bs-toggle="collapse" data-bs-target="#siteNav" aria-controls="siteNav" aria-expanded="false")
          span #{appName}
          i.bi.bi-chevron-down.brand-chevron(aria-hidden="true")
        #siteNav.collapse.w-100
          ul.nav-row
            each page in pages.filter((p) => p.nav)
              - const isActive = currentPath === page.path
              li
                a.nav-pill(href=page.path class={ active: isActive } aria-current=(isActive ? 'page' : undefined))
                  i.bi(class=`bi-${page.icon}` aria-hidden="true")
                  | #{page.title}
            li.nav-row-divider(aria-hidden="true")
            li
              a.nav-pill(href="/login" class={ active: currentPath === '/login' })
                i.bi.bi-box-arrow-in-right(aria-hidden="true")
                | Log In
            li
              a.nav-pill.nav-pill-solid(href="/register" class={ active: currentPath === '/register' })
                i.bi.bi-person-plus(aria-hidden="true")
                | Sign Up

    main#main.flex-grow-1
      block content

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")
