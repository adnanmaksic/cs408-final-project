doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= title ? `${title} | ${appName}` : `${appName} | Assignments and grades in one place`
    link(rel="icon" href="/favicon.svg" type="image/svg+xml")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css")
    link(rel="stylesheet" href="/css/custom.css")
  body.d-flex.flex-column.min-vh-100
    a.visually-hidden-focusable.position-absolute.p-2.bg-white(href="#main") Skip to content

    nav.navbar.navbar-expand-lg.navbar-dark.bg-primary.shadow-sm
      .container
        a.navbar-brand.fw-bold(href="/")
          i.bi.bi-mortarboard-fill.me-2(aria-hidden="true")
          | #{appName}
        button.navbar-toggler(type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation")
          span.navbar-toggler-icon
        #mainNav.collapse.navbar-collapse
          ul.navbar-nav.me-auto.mb-2.mb-lg-0
            each page in pages.filter((p) => p.nav)
              - const isActive = currentPath === page.path
              li.nav-item
                a.nav-link(href=page.path class={ active: isActive } aria-current=(isActive ? 'page' : undefined))
                  i.bi.me-1(class=`bi-${page.icon}` aria-hidden="true")
                  | #{page.title}
          .d-flex.gap-2.pb-2.pb-lg-0
            a.btn.btn-outline-light.btn-sm(href="/login") Log In
            a.btn.btn-light.btn-sm(href="/register") Sign Up

    main#main.flex-grow-1
      block content

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")
