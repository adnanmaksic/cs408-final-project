doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= title ? `${title} | ${appName}` : `${appName} | Assignments and grades in one place`
    link(rel="icon" href="/favicon.svg" type="image/svg+xml")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css")
    link(rel="stylesheet" href="/css/custom.css")
  body.d-flex.flex-column.min-vh-100
    a.visually-hidden-focusable.position-absolute.p-2.bg-white(href="#main") Skip to content

    //- Centered brand; clicking it opens a dropdown with every page.
    nav.navbar.navbar-dark.app-navbar
      .container.justify-content-center
        .dropdown-center
          button.brand-toggle(type="button" data-bs-toggle="dropdown" data-bs-offset="0,12" aria-expanded="false")
            span.brand-logo(aria-hidden="true")
              i.bi.bi-mortarboard-fill
            span.brand-name #{appName}
          .dropdown-menu.nav-menu
            h2.nav-menu-heading Menu
            ul.list-unstyled.mb-0
              each page in pages.filter((p) => p.nav)
                - const isActive = currentPath === page.path
                li
                  a.nav-menu-item(href=page.path class={ active: isActive } aria-current=(isActive ? 'page' : undefined))
                    span.nav-menu-icon(aria-hidden="true")
                      i.bi(class=`bi-${page.icon}`)
                    span.flex-grow-1 #{page.title}
                    if page.checkpoint
                      span.nav-menu-badge WIP
            .nav-menu-actions
              a.btn.btn-outline-primary.btn-sm.flex-fill(href="/login") Log In
              a.btn.btn-primary.btn-sm.flex-fill(href="/register") Sign Up

    main#main.flex-grow-1
      block content

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")
