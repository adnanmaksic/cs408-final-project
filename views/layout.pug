doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= title ? `${title} | ${appName}` : `${appName} | Assignments and grades in one place`
    link(rel="icon" href="/favicon.svg" type="image/svg+xml")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css")
    link(rel="stylesheet" href="/css/custom.css")
  body.d-flex.flex-column.min-vh-100
    a.visually-hidden-focusable.position-absolute.p-2.bg-white(href="#main") Skip to content

    //- Centered brand; clicking it opens a dropdown with every page.
    nav.navbar.navbar-dark.bg-primary.shadow-sm
      .container.justify-content-center
        .dropdown-center
          button.navbar-brand.brand-toggle.fw-bold.dropdown-toggle.me-0(type="button" data-bs-toggle="dropdown" aria-expanded="false")
            i.bi.bi-mortarboard-fill.me-2(aria-hidden="true")
            | #{appName}
          ul.dropdown-menu.shadow
            each page in pages.filter((p) => p.nav)
              - const isActive = currentPath === page.path
              li
                a.dropdown-item(href=page.path class={ active: isActive } aria-current=(isActive ? 'page' : undefined))
                  i.bi.me-2(class=`bi-${page.icon}` aria-hidden="true")
                  | #{page.title}
            li
              hr.dropdown-divider
            li
              a.dropdown-item(href="/login" class={ active: currentPath === '/login' })
                i.bi.bi-box-arrow-in-right.me-2(aria-hidden="true")
                | Log In
            li
              a.dropdown-item(href="/register" class={ active: currentPath === '/register' })
                i.bi.bi-person-plus.me-2(aria-hidden="true")
                | Sign Up

    main#main.flex-grow-1
      block content

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")
