extends ../layout

block content
  - const assignmentTotal = categories.reduce((sum, c) => sum + c.assignment_count, 0)
  .container.py-5
    nav(aria-label="breadcrumb")
      ol.breadcrumb
        li.breadcrumb-item
          a(href="/courses") My Courses
        li.breadcrumb-item.active(aria-current="page")= course.code

    .d-flex.flex-wrap.align-items-start.justify-content-between.gap-3.mb-4
      div
        span.course-badge.mb-2(style=`--course-color: ${course.color}`)= course.code
        h1.h2.mb-1= course.name
        p.text-body-secondary.mb-0
          if course.instructor
            | #{course.instructor} ·#{' '}
          | #{course.term} · Target #{course.target_grade}%
      .d-flex.flex-wrap.gap-2
        a.btn.btn-primary(href=`/assignments/new?course_id=${course.id}`)
          i.bi.bi-plus-lg.me-1(aria-hidden="true")
          | Add Assignment
        a.btn.btn-outline-primary(href=`/courses/${course.id}/calculator`)
          i.bi.bi-calculator.me-1(aria-hidden="true")
          | Grade Calculator
        a.btn.btn-outline-primary(href=`/courses/${course.id}/edit`)
          i.bi.bi-pencil.me-1(aria-hidden="true")
          | Edit
        button.btn.btn-outline-danger(type="button" data-bs-toggle="modal" data-bs-target="#deleteCourseModal"
          data-course-name=`${course.code}: ${course.name}` data-course-action=`/courses/${course.id}/delete`
          data-course-categories=categories.length data-course-assignments=assignmentTotal)
          i.bi.bi-trash.me-1(aria-hidden="true")
          | Delete

    - const pct = grade.percent === null ? 0 : Math.max(0, Math.min(100, grade.percent))
    .card.border-0.shadow-sm.mb-4
      .card-body.p-4
        .row.g-4.align-items-center
          .col-md-5
            .text-body-secondary.small.text-uppercase.fw-semibold Current grade
            .d-flex.align-items-baseline.gap-2
              span.display-6.fw-bold#currentGrade= grades.formatPercent(grade.percent)
              if grade.letter
                span.badge.fs-6.text-bg-primary= grade.letter
            if grade.percent === null
              .small.text-body-secondary No graded work yet. Scores you enter will show up here.
            else if grade.gradedWeight < 100
              .small.text-body-secondary Based on #{grades.round(grade.gradedWeight)}% of the course graded so far.
          .col-md-7
            .progress(role="progressbar" aria-label="Current grade" aria-valuenow=grades.round(pct) aria-valuemin="0" aria-valuemax="100" style="height: 1.25rem")
              .progress-bar(style=`width: ${pct}%; background-color: ${course.color}`)
            .d-flex.justify-content-between.small.text-body-secondary.mt-2
              span Target #{grades.formatPercent(course.target_grade)}
              a.text-decoration-none(href=`/courses/${course.id}/calculator`) What do I need?
            p.mb-0.mt-2.small= grade.neededText

    each cat in categories
      .card.border-0.shadow-sm.mb-4
        .card-body.p-4
          .d-flex.flex-wrap.align-items-center.justify-content-between.gap-2.mb-3
            h2.h5.mb-0
              | #{cat.name}
              span.badge.rounded-pill.text-bg-light.border.ms-2 #{cat.weight}%
              if cat.percent === null
                span.small.fw-normal.text-body-secondary.ms-2 No grades yet
              else
                span.small.fw-semibold.ms-2 #{grades.formatPercent(cat.percent)}
                span.small.fw-normal.text-body-secondary.ms-1 (#{grades.round(cat.earned)} / #{grades.round(cat.possible)} pts)
            a.btn.btn-sm.btn-outline-primary(href=`/assignments/new?course_id=${course.id}&category_id=${cat.id}` aria-label=`Add assignment to ${cat.name}`)
              i.bi.bi-plus-lg.me-1(aria-hidden="true")
              | Add

          if !cat.assignments.length
            p.text-body-secondary.small.mb-0 No assignments yet.
          else
            .table-responsive
              table.table.table-hover.align-middle.mb-0
                thead
                  tr
                    th(scope="col") Assignment
                    th(scope="col") Due
                    th(scope="col") Status
                    th(scope="col") Score
                    th.text-end(scope="col") Actions
                tbody
                  each a in cat.assignments
                    - const overdue = isOverdue(a)
                    - const status = assignmentStatuses[a.status]
                    tr
                      td
                        a.fw-semibold.text-decoration-none(href=`/assignments/${a.id}/edit`)= a.title
                        if a.description
                          .small.text-body-secondary= a.description
                      td.text-nowrap(class={ 'text-danger fw-semibold': overdue })
                        = formatDue(a.due_date)
                        if overdue
                          .small Overdue
                      td
                        span.badge(class=status.badge)= status.label
                      td.text-nowrap
                        if a.points_earned === null
                          span.text-body-secondary — / #{a.points_possible}
                        else
                          | #{a.points_earned} / #{a.points_possible}
                      td.text-end.text-nowrap
                        if ['not_started', 'in_progress'].includes(a.status)
                          form.d-inline(method="post" action=`/assignments/${a.id}/submit`)
                            button.btn.btn-sm.btn-outline-success.me-1(type="submit" aria-label=`Mark ${a.title} as submitted`)
                              i.bi.bi-check-lg(aria-hidden="true")
                              span.d-none.d-lg-inline.ms-1 Mark submitted
                        a.btn.btn-sm.btn-outline-primary.me-1(href=`/assignments/${a.id}/edit` aria-label=`Edit ${a.title}`)
                          i.bi.bi-pencil(aria-hidden="true")
                        button.btn.btn-sm.btn-outline-danger(type="button" data-bs-toggle="modal" data-bs-target="#deleteAssignmentModal"
                          data-delete-name=a.title data-delete-action=`/assignments/${a.id}/delete` aria-label=`Delete ${a.title}`)
                          i.bi.bi-trash(aria-hidden="true")

  include _delete-modal
  include ../assignments/_delete-modal

block scripts
  script(src="/js/delete-modal.js")
